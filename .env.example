# Veridica Agent Environment Variables

# MIMO API Configuration
VERIDICA_API_KEY=your_mimo_api_key_here
VERIDICA_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
VERIDICA_MODEL=mimo-v2.5-pro

# Optional: CryptoPanic API (free tier)
# CRYPTOPANIC_API_KEY=your_cryptopanic_key_here

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
